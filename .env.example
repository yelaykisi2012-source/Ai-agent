# MyAIAgent configuration — copy this file to .env and edit values.
# NEVER commit .env; it will hold API keys from Phase 2 onward.

# --- Application -----------------------------------------------------------
APP_NAME=MyAIAgent
# development | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Locale ----------------------------------------------------------------
# IANA timezone used for reminders and schedule display.
TIMEZONE=Asia/Tashkent

# --- Database --------------------------------------------------------------
# Relative SQLite paths resolve against the project root.
DATABASE_URL=sqlite:///./data/agent.db

# --- Local HTTP API --------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- OpenAI ----------------------------------------------------------------
# Paste your key here. It is read only by the server and never logged.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. Leave empty for api.openai.com.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
# Any current Chat Completions model. gpt-5-mini is a good default;
# gpt-4.1-mini also works but is scheduled for shutdown in January 2027.
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_DELAY=0.5
OPENAI_RETRY_MAX_DELAY=8
OPENAI_MAX_TOOL_ROUNDS=3

# --- Chat provider ---------------------------------------------------------
# openai    -> uses OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL above
#              (OPENAI_BASE_URL may point at any OpenAI-compatible endpoint,
#              for example Gemini: https://generativelanguage.googleapis.com/v1beta/openai/)
# openrouter -> uses OPENROUTER_API_KEY / OPENROUTER_MODEL below
LLM_PROVIDER=openai
# Key from https://openrouter.ai/settings/keys. Never logged, never committed.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free tier: "openrouter/free" routes to a live free model. To pin one, use a
# current ":free" id from https://openrouter.ai/models?max_price=0
# Pin a concrete free model so calls do not land on a random router pick.
# "openrouter/free" routes to any live free model and changes per request.
OPENROUTER_MODEL=openrouter/free

# Speech. whisper-1 is the most stable transcription model.
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
VOICE_MAX_UPLOAD_MB=15

# Speech backend: openai | gemini. "gemini" uses Gemini transcribe + TTS
# models and needs a Google AI Studio key in OPENAI_API_KEY. The speech
# provider is independent of LLM_PROVIDER (OpenRouter has no chat audio path).
# Second transcription model tried when the first is rate limited (429). Same
# key, different quota; empty keeps a single model with bounded retries.
GEMINI_STT_FALLBACK_MODEL=
# One transcription request times out after this many seconds, and the whole
# utterance (primary + fallback) has this total budget.
GEMINI_STT_TIMEOUT_SECONDS=8
GEMINI_STT_TOTAL_SECONDS=12

# --- Text to speech --------------------------------------------------------
# Primary TTS backend: empty (follow SPEECH_PROVIDER) | openai | gemini | edge
# Transcription always follows SPEECH_PROVIDER; only synthesis uses this.
TTS_PROVIDER=
# Used only when the primary TTS fails (e.g. Gemini HTTP 429). Empty disables
# it. "edge" = Microsoft Edge neural voices via the edge-tts package: no
# account, no API key; needs network plus FFmpeg for 24 kHz PCM conversion.
TTS_FALLBACK_PROVIDER=edge
# uz-UZ-MadinaNeural | uz-UZ-SardorNeural (list: edge-tts --list-voices)
EDGE_TTS_VOICE=uz-UZ-MadinaNeural
# Speaking rate, pitch and volume for the Edge voice. The neural voices are
# slow at +0% for a live call; +25% is still natural and noticeably shorter.
EDGE_TTS_RATE=+25%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%
# Language Ksenus speaks on a call. Spoken answers are always Uzbek; this is
# also used to check that the TTS voice above really belongs to that language
# (a mismatch is logged as a warning at startup instead of being ignored).
VOICE_LANGUAGE=uz
# Language hint for transcription. EMPTY = the provider auto-detects, which is
# what a call needs: the person may speak Russian or English and still get an
# Uzbek answer. "uz" forces Uzbek-only recognition and will mis-hear anything
# else. Note: only OpenAI/Whisper and the Gemini chat-model STT fallback accept
# a hint; the dedicated Gemini transcribe model is sent audio only.
STT_LANGUAGE=
TTS_TIMEOUT_SECONDS=45

# --- Live-call latency -----------------------------------------------------
# Model used for spoken turns only. Empty = CHAT_MODEL. A smaller, faster model
# here shortens the wait on a call without touching chat quality.
CALL_LLM_MODEL=
# Previous messages kept as call context. Fewer messages = a faster first
# sentence; a phone conversation rarely needs the full chat window.
CALL_CONTEXT_MESSAGES=8

# --- Telegram delivery -----------------------------------------------------
# Files the assistant may send to the owner's own chat (TELEGRAM_OWNER_USER_ID).
# There is no setting for another recipient: external chats are not supported.
TELEGRAM_DELIVERY_MAX_MB=20

# --- Chat latency ----------------------------------------------------------
# Hard cap on generated tokens; 0 keeps the provider default. A small value
# keeps replies short and makes slow free models finish sooner.
LLM_MAX_TOKENS=0
# Chat request timeout in seconds; 0 falls back to OPENAI_TIMEOUT_SECONDS.
LLM_TIMEOUT_SECONDS=0

# --- Call voice activity ---------------------------------------------------
# Trailing silence that ends one utterance (ms). Shorter cuts slow speech.
TELEGRAM_CALL_SILENCE_MS=900
# Consecutive loud audio needed to interrupt Ksenus (ms): stops speaker echo
# from being mistaken for the caller speaking.
TELEGRAM_CALL_BARGE_IN_MS=300
# Energy multiplier while Ksenus speaks; echo must be this much louder.
TELEGRAM_CALL_BARGE_IN_THRESHOLD_SCALE=2.0
# Playback starts are echo-heavy: barge-in is ignored for this many ms.
TELEGRAM_CALL_BARGE_IN_GRACE_MS=250
# A queued utterance older than this is skipped instead of answered late.
TELEGRAM_CALL_STALE_UTTERANCE_SECONDS=8
SPEECH_PROVIDER=openai
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_VOICE=Kore

# --- Conversation ----------------------------------------------------------
CHAT_CONTEXT_MESSAGES=20
CHAT_RATE_LIMIT_PER_MINUTE=30
# Optional replacement persona; safety rules are always appended.
# SYSTEM_PROMPT=You are my calm bilingual Uzbek/English assistant.

# --- Telegram user account -------------------------------------------------
# Get api_id/api_hash at https://my.telegram.org/apps for the KSENUS account.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Session file (no extension). Created by the login command. Never commit it.
TELEGRAM_SESSION_PATH=data/telegram/ksenus
# Filled automatically by: python -m telegram.authentication login
TELEGRAM_OWNER_USER_ID=
# Incoming calls are declined unless audio is enabled AND verified.
TELEGRAM_ALLOW_INCOMING_CALLS=false
TELEGRAM_CALLS_ENABLED=false
# Any Telegram user may call Ksenus, not only the owner. A guest caller is
# answered with guest rules: no tools, no owner data, redacted replies and
# their own conversation. Set to false to accept the owner's calls only.
TELEGRAM_PUBLIC_CALLS_ENABLED=true
TELEGRAM_CALL_AUTO_ANSWER=true
TELEGRAM_CALL_MAX_SECONDS=900
TELEGRAM_CALL_RING_TIMEOUT_SECONDS=45
TELEGRAM_CALL_CONNECT_TIMEOUT_SECONDS=30
TELEGRAM_CALL_RECONNECT_GRACE_SECONDS=20
TELEGRAM_CALL_SILENCE_MS=700
TELEGRAM_CALL_MIN_SPEECH_MS=300
TELEGRAM_CALL_ENERGY_THRESHOLD=400

# --- Talking to other people -----------------------------------------------
# Leave false to answer only TELEGRAM_OWNER_USER_ID and the ids below.
# When true, any Telegram user who writes first is answered as a guest: no
# tools, no owner data, and their own conversation history.
TELEGRAM_PUBLIC_CHAT_ENABLED=false
# Comma-separated ids ("123, 456") or a JSON list. These people may chat even
# when public chat is off, and only they may be called after they say yes.
TELEGRAM_ALLOWED_USER_IDS=
# How long one "yes, call me" stays valid. One yes buys exactly one call.
TELEGRAM_CALL_CONSENT_SECONDS=600
# Silence after Ksenus says goodbye before the call is really ended. Any new
# speech in this window cancels the ending.
TELEGRAM_CALL_GOODBYE_GRACE_SECONDS=3

# --- Autonomy and security -------------------------------------------------
# Optional. When set, mutating API calls need X-API-Token.
API_TOKEN=
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_MINUTES=5
DASHBOARD_ENABLED=true
